bpm = 130.0
ENV_FREQ = 1.0
ENV_DURATION = 0.2

ENV_PHASOR = phasor(ENV_FREQ)
ENV = adsr(ENV_PHASOR, ENV_DURATION, 0.5, 0.5, 0.1, 1)

LFO_FREQ = 0.1
LFO_PHASOR = phasor(LFO_FREQ)
LFO_OUT = sine(LFO_PHASOR)

PITCH = 440.0
PITCH_MOD = mul(LFO_OUT, 12.0)
FINAL_PITCH = add(PITCH, PITCH_MOD)
FREQ = mtof(FINAL_PITCH)

RAW_PHASOR = phasor(FREQ)
RAW_OSC = sine(RAW_PHASOR)

CUTOFF = map(LFO_OUT, -1.0, 1.0, 400.0, 1000.0)
FILTERED = filter(RAW_OSC, 0.0, CUTOFF, 5.0)

ENV_APPLIED = mul(FILTERED, ENV)

DELAYED = delay(ENV_APPLIED, 0.5, 0.4)

FINAL_SIG = add(ENV_APPLIED, DELAYED)

MASTER_GAIN = 0.3
OUTPUT = mul(FINAL_SIG, MASTER_GAIN)
out = OUTPUT
