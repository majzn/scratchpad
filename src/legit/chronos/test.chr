# ==========================================
# CHRONOS PROGRESSIVE HOUSE DEMO (REFINED)
# ==========================================

# 1. GLOBAL TRANSPORT
# -------------------
bpm = 128

# 2. HELPER MACROS
# ----------------
# Basic Sawtooth Oscillator: Maps phasor (0..1) to (-1..1)
def saw(freq) {
    p = phasor(freq)
    return (p - 0.5) * 2.0
}

# 3. INSTRUMENT DEFINITIONS
# -------------------------

# Kick: Exponential pitch drop + resonant click + saturation
def kick(trig) {
    # Amplitude Envelope
    e_amp = adsr(trig, 0.005, 0.4)
    # Pitch Envelope (Short and punchy)
    e_p = adsr(trig, 0.002, 0.12)
    
    # Exponential pitch sweep: 50Hz base + (Envelope^2 * Range)
    # Squaring the envelope creates a punchier "thud"
    freq = 55 + (e_p * e_p * 200)
    
    osc = sine(freq)
    
    # Add a tiny bit of noise click at the start
    click = filter(noise(), 0, 2000, 2.0) * adsr(trig, 0.001, 0.01)
    
    # Drive the output into tanh for harmonic saturation
    return tanh((osc + click * 0.2) * e_amp * 4.0)
}

# Clap: Band-passed noise for "wood" texture
def clap(trig) {
    e = adsr(trig, 0.002, 0.15)
    # Filter Type 0 = Band Pass. Center at 1200Hz gives good "smack"
    n = filter(noise(), 0, 1200, 1.0)
    return n * e * 1.5
}

# Hi-Hat: High-passed metallic noise
def hat(trig) {
    e = adsr(trig, 0.002, 0.05)
    # Type 2 = High Pass. Remove low rumble.
    n = filter(noise(), 2, 9000, 1.0) 
    return n * e * 0.6
}

# Bass: Detuned Sawtooths + Resonant Low Pass Filter
def bass(trig, note) {
    freq = mtof(note)
    e_filt = adsr(trig, 0.01, 0.25)
    e_amp = adsr(trig, 0.01, 0.4)
    
    # Dual Oscillator Detune (Fat Bass)
    osc1 = saw(freq)
    osc2 = saw(freq * 1.01) # Slightly sharp
    raw = (osc1 + osc2) * 0.5
    
    # Resonant Filter Sweep
    # Cutoff moves from 100Hz up to 3000Hz based on envelope
    cut = 100 + (e_filt * 3000)
    # Type 1 = Low Pass, Q = 1.5 (Resonant)
    sig = filter(raw, 1, cut, 1.5)
    
    return sig * e_amp
}

# Super Saw Lead: 3 Detuned Oscillators for width
def lead(trig, note) {
    freq = mtof(note)
    e = adsr(trig, 0.02, 0.6)
    
    s1 = saw(freq)
    s2 = saw(freq * 1.008) # +8 cents
    s3 = saw(freq * 0.992) # -8 cents
    
    # Average them
    mix = (s1 + s2 + s3) * 0.33
    
    # High pass to clean up mix space for bass
    mix = filter(mix, 2, 300, 0.7)
    
    # Stereo Delay effect (Ping-pong simulated via mono delay for now)
    wet = delay(mix, 0.35, 0.5) 
    
    return (mix + wet * 0.4) * e
}

# Epic Pad: Swelling Sawtooths with heavy Reverb
def pad(gate, note) {
    freq = mtof(note)
    # Slow attack (1s) and release (2s)
    e = adsr(gate, 1.0, 2.0) 
    
    s1 = saw(freq)
    s2 = saw(freq * 1.004)
    
    # Smooth LPF
    raw = filter((s1 + s2) * 0.5, 1, 800, 0.5)
    
    return reverb(raw * e, 4.0, 0.6)
}

# 3. SEQUENCING
# -------------

# Master Clock: 16th notes
clk = phasor(16 * bpm / 240)
trig_16 = (clk - floor(clk)) < 0.1

# Patterns
p_kick = seq(0.1, rhythm("x...x...x...x..."))
p_clap = seq(0.1, rhythm("....x.......x..."))
p_hat  = seq(0.1, rhythm("..x...x...x...x."))
p_bass = seq(0.1, rhythm("x.x.x.x.x.x.x.x."))

# Bass Note Progression (changes every 4 bars? handled in logic or long seq)
# Simple 1-bar loop for now
n_bass = seq(0.4, 36, 36, 39, 41) 

# Lead Melody
p_lead = seq(0.1, rhythm("x.xx.x.x..x.x..."))
n_lead = seq(0.1, 60, 63, 67, 72, 60, 63, 67, 70) 

# Pad Chords
chord_root = seq(1.6, 48, 43, 46, 51) # Lower octave for pad

# 4. ARRANGEMENT
# --------------

drum_bus = 0
bass_bus = 0
lead_bus = 0
pad_bus = 0

# Automation LFOs
slow_lfo = sine(0.1) * 0.5 + 0.5 # 0 to 1 slow wave

if (bars < 8) {
    # INTRO
    # Filter opens up slowly
    filt_auto = 200 + (bars * 400)
    # Filtered Kick
    k = filter(kick(trig_16 * p_kick), 1, filt_auto, 1.0)
    drum_bus = k
    
    pad_bus = pad(1, chord_root) * 0.5
} 
else {
    if (bars < 16) {
        # BUILD UP
        drum_bus = kick(trig_16 * p_kick) + hat(trig_16 * p_hat)
        
        # Snare build at end
        fill = 0
        if (bars >= 15) {
            roll = phasor(32 * bpm / 240)
            fill = clap((roll - floor(roll)) < 0.5) * 0.8
        } else {
            fill = clap(trig_16 * p_clap)
        }
        drum_bus = drum_bus + fill
        
        pad_bus = pad(1, chord_root) * 0.6
        
        # Tease the lead
        lead_vol = (bars - 8) / 8.0
        # High pass the lead during build
        lead_raw = lead(trig_16 * p_lead, n_lead)
        lead_bus = filter(lead_raw, 2, 500 + (1-lead_vol)*1000, 1.0) * lead_vol
    } 
    else {
        if (bars < 32) {
            # DROP
            drum_bus = kick(trig_16 * p_kick) + clap(trig_16 * p_clap) + hat(trig_16 * p_hat)
            bass_bus = bass(trig_16 * p_bass, n_bass)
            lead_bus = lead(trig_16 * p_lead, n_lead)
            pad_bus = 0 # Clean mix
        }
        else {
            # OUTRO
            drum_bus = kick(trig_16 * p_kick)
            bass_bus = bass(trig_16 * p_bass, n_bass)
            lead_bus = lead(trig_16 * p_lead, n_lead) * 0.2
        }
    }
}

# 5. MASTER MIX
# -------------

mix = drum_bus + bass_bus * 0.9 + lead_bus * 0.7 + pad_bus

# Master Compressor to glue
# Threshold -12dB, Ratio 4:1
comp = compress(mix, -12, 4, 0.05)

# Limiter to catch peaks
final = limit(comp)

out = final