# --------------------------------------------------
# Global Constants & Setup
# --------------------------------------------------
out_amp = 0.5    # Global volume
sr = 44100.0     # Sample Rate
bpm = 100.0
time_per_beat = 60.0 / bpm 

# Helper function to get frequency (used outside array() definitions)
def freq(midinote) {
    return mtof(midinote)
}

# --------------------------------------------------
# 1. Percussion Layer (Kick and Hi-Hat)
# --------------------------------------------------

# --- Kick Drum (Sine Wave Pitch Drop) ---
kick_gate = seq(time_per_beat * 2, 1, 0, 0, 0) # Hits on beats 1 and 3
kick_env = adsr(kick_gate, 0.001, 0.2) * 0.9 # Fast attack, short decay
freq_start = lerp(100.0, 30.0, kick_env) 
kick_osc = sine(phasor(freq_start))
kick_out = clip(kick_osc * kick_env * 1.5) 
kick_out = lpf(kick_out, 500.0, 0.5) * 0.5

# --- Hi-Hat (Noise with high-pass filter) ---
hat_gate = seq(time_per_beat, 0, 1, 0, 1) # Hits on beats 2 and 4
hat_env = adsr(hat_gate, 0.005, 0.1) * 0.8
hat_noise = noise() * hat_env
hat_out = filter(hat_noise, 2, 8000.0, 0.5) * 0.2 # Type 2 is High-pass filter

# --------------------------------------------------
# 2. Bass Line 
# --------------------------------------------------
bass_gate = seq(time_per_beat * 2, 1, 0, 1, 0) 
bass_env = adsr(bass_gate, 0.01, 0.2)
bass_freq = freq(30)
bass_osc = sine(phasor(bass_freq))
bass_out = lpf(bass_osc * bass_env, 120.0, 0.5) * 0.4

# --------------------------------------------------
# 3. Ambient Chord Pad (Harmonies)
# C3 -> Eb3 -> F3 -> G3 (16 beats total loop)
# --------------------------------------------------
# FIXED: Using constant values to resolve compile-time error.
chord_notes = array(130.8128, 155.5635, 174.6141, 195.9977)
chord_duration = time_per_beat * 4 
sequence_freq = 1.0 / (chord_duration * 4.0)

phase = phasor(sequence_freq) * 4.0 
chord_sel = floor(phase)
root_freq = get(chord_notes, chord_sel)

# Harmony voices
fifth_freq = root_freq * 1.5
third_freq = root_freq * 1.189 

pad_gate = 1.0
pad_env = adsr(pad_gate, 2.0, 10.0)

osc_root = sine(phasor(root_freq)) * 0.5
osc_fifth = sine(phasor(fifth_freq * 1.005)) * 0.3
osc_third = sine(phasor(third_freq * 0.995)) * 0.2

pad_mix = osc_root + osc_fifth + osc_third
pad_out = lpf(pad_mix * pad_env, 1500.0, 0.9) * 0.3

# --------------------------------------------------
# 4. Lead Melody 
# C4, D4, C4, F4 - loops over 2 beats
# --------------------------------------------------
melody_step = time_per_beat / 2.0 

# FIXED: Using constant values to resolve compile-time error.
melody_notes = array(261.6256, 293.6648, 261.6256, 349.2282) 
melody_loop_freq = 1.0 / (melody_step * 4.0) 

mel_phase = phasor(melody_loop_freq) * 4.0
mel_sel = floor(mel_phase)
mel_freq = get(melody_notes, mel_sel)

mel_gate = seq(melody_step, 1, 0, 1, 0, 1, 0, 1, 0) 

mel_env = adsr(mel_gate, 0.01, 0.5)
mel_osc = phasor(mel_freq) * 2.0 - 1.0 # Phasor creates a saw wave
mel_out = filter(mel_osc * mel_env, 1, 1500.0, 0.5) * 0.4 # Type 1 is Low-pass filter

# --------------------------------------------------
# 5. Wav Loop Texture 
# --------------------------------------------------
wav_loop = load("sample.wav") 
wav_out = filter(wav_loop, 2, 500.0, 0.5) * 0.1 

# --------------------------------------------------
# Final Mix & Output (Stereo)
# --------------------------------------------------
master_mix = bass_out + pad_out + mel_out + kick_out + hat_out + wav_out

# Apply final soft clip (tanh) and volume reduction
master_out = tanh(master_mix * 2.0) * out_amp

# Output with simple stereo delay
output.0 = delay(master_out, 0.2, 0.5) * 0.5 + master_out * 0.5 
output.1 = delay(master_out, 0.25, 0.5) * 0.5 + master_out * 0.5