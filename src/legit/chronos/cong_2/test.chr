def kick(trig) {
  e_amp = perc(trig, 0.001, 0.4)
  e_freq = perc(trig, 0.001, 0.1)
  osc = sine(50.0 + (e_freq * 150.0))
  return osc * e_amp
}

def hat(trig) {
  n = noise()
  e = perc(trig, 0.001, 0.05)
  return filter(n, 1, 8000, 1.0) * e
}

def bass(g, f) {
  osc = saw(f)
  cut = 200 + (adsr(g, 0.01, 0.2, 0.0, 0.0) * 1000)
  sig = filter(osc, 0, cut, 2.0)
  amp = adsr(g, 0.01, 0.1, 0.8, 0.1)
  return sig * amp
}

def lead(g, f) {
  lfo = sine(4.0)
  osc = pulse(f, 0.5 + (lfo * 0.4))
  sig = delay(osc, 0.25, 0.4)
  amp = adsr(g, 0.05, 0.2, 0.5, 0.3)
  return sig * amp
}

k = kick(trk_gate(0))
b = bass(trk_gate(1), trk_freq(1))
l = lead(trk_gate(2), trk_freq(2))
h = hat(trk_gate(3))

out = (k * 0.8) + (b * 0.6) + (l * 0.4) + (h * 0.3)

